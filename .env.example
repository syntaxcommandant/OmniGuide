# OmniGuide Environment Configuration Template
# Copy this file to .env and supply your credentials

# Database (PostgreSQL hosted on Neon or Render, or SQLite for local dev)
# Example Neon PostgreSQL URL:
# DATABASE_URL=postgresql+psycopg://username:password@ep-xyz.us-east-2.aws.neon.tech/omniguide?sslmode=require
DATABASE_URL=sqlite:///./omniguide.db

# AI Provider Configuration (Google Gemini Flash)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
GEMINI_MODEL=gemini-2.5-flash

# Optional Secondary Provider
GROQ_API_KEY=

# Default Governance Mode: "hybrid" (AI + Deterministic) or "deterministic"
DEFAULT_ANALYSIS_MODE=hybrid

# Permitted CORS Origins (comma separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,https://omniguide.vercel.app

# Max Upload Size (MB)
UPLOAD_MAX_SIZE_MB=15
